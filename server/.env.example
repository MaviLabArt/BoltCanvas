# --- General server config ---
# Default here is suitable for production deployments.
# For local testing, you can change NODE_ENV to "development" and point CORS_ORIGIN to your dev URL.
NODE_ENV=production
PORT=8080
# Comma-separated list of allowed frontend origins.
# Change this to your real domain(s) in production, e.g. https://shop.example.com
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,https://shop.example.com
SESSION_SECRET=replace-with-long-random-string
# this is the password you are asked to access /admin dashboard
ADMIN_PIN=1234
# Set ADMIN_LANG either to English (en) or Italian (it)
ADMIN_LANG=en
# You can point this into a different path
DB_FILE=shop.db

# --- Choose providers separately ---
# Lightning provider, choose one: blink, lnd, btcpay, nwc, or lnurl
LIGHTNING_PAYMENT_PROVIDER=lnurl
# On-chain provider, choose one:
#   satsrouting = Submarine swap (BTC on-chain → Lightning; default)
#   btcpay      = Native on-chain invoice from your BTCPay store
#   xpub        = Derive addresses from an XPUB/VPUB/YPUB/ZPUB and poll mempool.space (Esplora)
ONCHAIN_PROVIDER=satsrouting
# --- On-chain ---
ONCHAIN_ENABLED=true
# Minimum sats to allow on-chain alongside Lightning
ONCHAIN_MIN_SATS=25000
# Invoice expiry (seconds) when creating on-chain requests; longer helps confirmations
ONCHAIN_INVOICE_EXPIRES_IN=7200

# --- XPUB on-chain provider (ONCHAIN_PROVIDER=xpub) ---
# Master public key from the wallet: IMPORTANT TO USE A FRESH XPUB TO AVOID ADDRESS REUSE!!!
ONCHAIN_XPUB=
# Esplora-compatible API base used to check payments (mempool.space by default)
ONCHAIN_XPUB_API_BASE=https://mempool.space/api


# SatsRouting endpoints (mainnet defaults)
SATSROUTING_REST_URL=https://api.satsrouting.exchange
SATSROUTING_WS_URL=wss://api.satsrouting.exchange/v2/ws
# Optional: HTTPS webhook endpoint; used only when the shared secret is configured.
#SATSROUTING_WEBHOOK_URL=https://shop.example.com/api/webhooks/satsrouting
SATSROUTING_WEBHOOK_SECRET=replace-with-long-random-string
# Optional IPv4 retry on hosts with broken IPv6 connectivity.
SATSROUTING_FORCE_IPV4=0

# Deterministic refund keys for SatsRouting swaps. Back up this mnemonic securely.
SATSROUTING_RESCUE_MNEMONIC=
SATSROUTING_RESCUE_PATH=m/44/0/0/0
# Legacy Boltz settings: retained only to read/refund old orders, not for new checkouts.
BOLTZ_REST_URL=https://api.boltz.exchange
BOLTZ_WS_URL=wss://api.boltz.exchange/v2/ws
BOLTZ_WEBHOOK_URL=
BOLTZ_WEBHOOK_SECRET=
# Leave empty in new installations. For existing Boltz orders, restore the real mnemonic
# from your previous server/.env if you need to keep the historical refund-key derivation.
BOLTZ_RESCUE_MNEMONIC=
BOLTZ_RESCUE_PATH=m/44/0/0/0

# --- Blink credentials, generate api key from https://dashboard.blink.sv/api-keys---
BLINK_GRAPHQL_URL=https://api.blink.sv/graphql
BLINK_WS_URL=wss://ws.blink.sv/graphql
BLINK_API_KEY=
BLINK_INVOICE_EXPIRES_IN=900

# --- NWC (Nostr Wallet Connect, when PAYMENT_PROVIDER=nwc) ---
# Merchant NWC URL, e.g. nostr+walletconnect://<wallet-pubkey>?relay=...&secret=...
NWC_URL=
# Invoice expiry (seconds). Defaults to BLINK_INVOICE_EXPIRES_IN if unset.
NWC_INVOICE_EXPIRES_IN=900

# --- LNURL (LNURL-pay + LNURL-verify, when PAYMENT_PROVIDER=lnurl) works with blitz, zeus pay, breeze---
# Set one of the following:
# LNURL_LIGHTNING_ADDRESS=name@example.com
LNURL_LIGHTNING_ADDRESS=


# --- BTCPay Server (when PAYMENT_PROVIDER=btcpay) ---
BTCPAY_URL=https://btcpay.example.com
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
# Secret shown when you create the webhook in BTCPay; used to verify BTCPay-Sig
BTCPAY_WEBHOOK_SECRET=
# Optional: override payment method ids if your BTCPay uses different names (older versions)
# BTCPAY WEBHOOK: in BTC PAY SERVER Webhook settings, define https://shop.example.com/api/webhooks/btcpay , unless you change the path below
#BTCPAY_WEBHOOK_PATH=/api/webhooks/btcpay

# --- LND (optional, when PAYMENT_PROVIDER=lnd) ---
#LND_REST_URL=https://lnd.example.com:8080
#LND_MACAROON_HEX=
#LND_TLS_INSECURE=0
#LND_TLS_CERT_PATH=
#LND_INVOICE_EXPIRES_IN=900
#LND_PRIVATE_INVOICES=true
#LND_WS_URL=wss://lnd.example.com:8080
#LND_ONCHAIN_ADDR_TYPE=p2wkh
#LND_ONCHAIN_MIN_CONFIRMATIONS=1

# --- Order notifications (optional) ---
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
#NTFY_USER=
#NTFY_PASSWORD=
#NTFY_PRIORITY=high
#NTFY_TITLE_PREFIX=

# --- Nostr keys (this is for sending NOSTR DMs and NOSTR teasers) ---
# Required: each store needs its own key so Nostr comments are namespaced and signed
SHOP_NOSTR_NSEC=
NOSTR_RELAYS_CSV=wss://relay.damus.io,wss://nos.lol
DM_DEDUP_TTL_MS=300000
# Cache Nostr comment proofs per product (ms)
#COMMENT_PROOF_TTL_MS=60000

# --- Email / SMTP (optional, to DM status updates) ---
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Lightning Shop
SMTP_FROM_ADDRESS=hello@example.com
SMTP_ENVELOPE_FROM=hello@example.com
SMTP_REPLY_TO=hello@example.com
SMTP_SAVE_TO_SENT=false
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=Sent

# Nostr public key (npub or 64-character hex) of the site owner.
# Required for owner recognition and private shipping alerts.
OWNER_NOSTR_PUBKEY=
